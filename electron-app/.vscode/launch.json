{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: Dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "runtimeArgs": [".", "--dev"],
      "preLaunchTask": "build",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true
    },
    {
      "name": "Electron: Dev (Admin)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "Start-Process",
        "-FilePath", "${workspaceFolder}/node_modules/.bin/electron.cmd",
        "-ArgumentList", "'. --dev'",
        "-Verb", "RunAs"
      ],
      "preLaunchTask": "build",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
